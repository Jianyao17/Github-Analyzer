{
  "ConnectionStrings": {
    "postgresdb": ""
  },
  "Jwt": {
    "Issuer": "Github-Analyzer",
    "Audience": "Github-Analyzer.WebApp",
    "ExpirationInMinutes": 120
  },
  "Authentication": {
    "Google": {}
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 8,
      "RequiredUniqueChars": 1
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Write": {
      "PermitLimit": 3,
      "WindowInSeconds": 30,
      "SegmentsPerWindow": 3
    },
    "Authentication": {
      "PermitLimit": 5,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "AccountManagement": {
      "PermitLimit": 2,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Frontend": {},
  "Cors": {
    "AllowedOrigins": []
  },
  "Mail": {
    "Smtp": {
      "IsEnabled": false,
      "Host": "smtp.example.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "SenderEmail": "noreply@github-analyzer.com",
      "SenderName": "Github Analyzer",
      "UseSsl": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}