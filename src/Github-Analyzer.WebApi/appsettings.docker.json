{
  "ConnectionStrings": {
    "postgresdb": ""
  },
  "Jwt": {
    "Issuer": "Github-Analyzer",
    "Audience": "Github-Analyzer.WebApp",
    "ExpirationInMinutes": 120
  },
  "Authentication": {
    "Google": {}
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": false,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 8,
      "RequiredUniqueChars": 1
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "CreateProject": {
      "PermitLimit": 3,
      "WindowInSeconds": 30,
      "SegmentsPerWindow": 3
    },
    "Login": {
      "PermitLimit": 5,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Register": {
      "PermitLimit": 2,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6
    }
  },
  "Frontend": {},
  "Cors": {
    "AllowedOrigins": []
  },
  "Mail": {
    "IsEnabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "SenderEmail": "noreply@github-analyzer.com",
    "SenderName": "Github Analyzer",
    "UseSsl": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}